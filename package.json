{
  "name": "policy-impact-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/clean-build-output.mjs",
    "build": "tsc -b && vite build",
    "build:budget": "node scripts/check-bundle-budget.mjs",
    "crawl:sources": "node scripts/crawl-policy-sources.mjs",
    "policy:triage-test": "node scripts/test-policy-triage.mjs",
    "policy:crawl-contract-test": "node scripts/test-limited-crawl-contract.mjs",
    "manual:policies": "node scripts/manual-policy-analysis.mjs",
    "manual:validate": "node scripts/validate-manual-report.mjs",
    "manual:test": "node scripts/test-manual-report-validation.mjs",
    "manual:metrics": "node scripts/report-quality-metrics.mjs",
    "stage7:source-export": "node scripts/export-stage7-source-documents.mjs",
    "stage7:source-fetch": "node scripts/fetch-stage7-official-source-documents.mjs",
    "stage7:evidence-audit": "node scripts/audit-stage7-source-evidence.mjs",
    "stage7:source-crosscheck": "node scripts/crosscheck-stage7-source-documents.mjs",
    "stage7:shadow": "node scripts/build-report-revision-shadow.mjs",
    "stage7:diff": "node scripts/diff-report-revisions.mjs",
    "stage7:test": "node scripts/test-stage7-data-core.mjs && node scripts/test-stage7-db-load-guards.mjs",
    "stage7:migration-test": "node scripts/run-stage7-migration-pglite.mjs",
    "stage7:db-load": "node scripts/run-stage7-shadow-database-load.mjs",
    "edge:typecheck": "npx --yes deno-bin@2.2.7 check supabase/functions/ingest/index.ts supabase/functions/analyze/index.ts supabase/functions/publish/index.ts supabase/functions/revision-lifecycle/index.ts supabase/functions/model-budget/index.ts supabase/functions/account-governance/index.ts",
    "edge:test": "npx --yes deno-bin@2.2.7 test supabase/functions/_shared/http.test.ts",
    "auth:test": "node scripts/test-auth-boundary.mjs",
    "workflow:test": "node scripts/test-workflow-contracts.mjs",
    "workflow:generated-check": "node scripts/check-generated-workflows.mjs",
    "production:readiness:audit": "node scripts/audit-zero-cost-production-readiness.mjs",
    "production:guard:test": "node scripts/test-production-setup-guard.mjs",
    "backup:production": "node scripts/create-zero-cost-production-backup.mjs",
    "backup:guard:test": "node scripts/test-zero-cost-backup-guard.mjs",
    "backup:crypto:test": "node scripts/test-zero-cost-backup-crypto.mjs",
    "production:source-export": "node scripts/run-production-source-export.mjs",
    "production:source-guard:test": "node scripts/test-production-source-export-guard.mjs",
    "qa:production:authenticated": "node scripts/run-production-authenticated-qa.mjs",
    "security:audit": "npm audit --audit-level=high",
    "setup:production": "node scripts/configure-production.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.75.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  }
}

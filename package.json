{
  "name": "policy-impact-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:budget": "node scripts/check-bundle-budget.mjs",
    "crawl:sources": "node scripts/crawl-policy-sources.mjs",
    "operation:collect-hourly": "node scripts/crawl-policy-sources.mjs --manual-selection-only",
    "policy:triage-test": "node scripts/test-policy-triage.mjs",
    "policy:crawl-contract-test": "node scripts/test-limited-crawl-contract.mjs",
    "policy:attachment-test": "node scripts/test-policy-attachments.mjs",
    "policy:hourly-operations-test": "node scripts/test-hourly-policy-operations.mjs",
    "policy:hourly-recovery-test": "node scripts/test-hourly-recovery.mjs",
    "policy:hourly-audit": "node scripts/audit-hourly-policy-collection.mjs",
    "policy:operations-test": "npm run policy:triage-test && npm run policy:crawl-contract-test && npm run policy:attachment-test && npm run policy:hourly-operations-test && npm run policy:hourly-recovery-test",
    "manual:policies": "node scripts/manual-policy-analysis.mjs",
    "manual:validate": "node scripts/validate-manual-report.mjs",
    "manual:test": "node scripts/test-manual-report-validation.mjs",
    "manual:metrics": "node scripts/report-quality-metrics.mjs",
    "manual:inbox-migration-plan": "node scripts/plan-manual-inbox-migration.mjs",
    "operations:summary": "node scripts/build-production-operations-summary.mjs",
    "qa:production:authenticated": "node scripts/run-production-authenticated-qa.mjs",
    "backup:create": "node scripts/create-zero-cost-production-backup.mjs",
    "backup:verify": "node scripts/verify-zero-cost-production-backup.mjs",
    "backup:test": "node scripts/test-zero-cost-backup-crypto.mjs && node scripts/test-zero-cost-backup-guard.mjs && node scripts/test-zero-cost-backup-restore-guard.mjs",
    "production:write-readiness": "node scripts/audit-production-write-readiness.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:governance-audit": "node scripts/audit-repository-governance.mjs",
    "security:secret-scan": "node scripts/scan-repository-secrets.mjs",
    "security:workflow-test": "node scripts/test-workflow-security.mjs",
    "setup:production": "node scripts/configure-production.mjs",
    "setup:production-test": "node scripts/test-configure-production-guard.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.75.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  }
}

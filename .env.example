VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: set to edge-function to create jobs through Supabase Edge Functions.
VITE_ANALYSIS_JOB_MODE=
# Optional for GitHub Pages project sites, for example /policy-impact-terminal/.
VITE_BASE_PATH=
# Optional local demo only. Production builds must use Supabase instead of mock data.
VITE_ENABLE_MOCK=

# Optional for scripts/crawl-policy-sources.mjs --ingest.
SUPABASE_URL=

# Manual ingest: use an authenticated user access token.
SUPABASE_ACCESS_TOKEN=

# Scheduled ingest: use a JWT accepted by Supabase Edge Functions, plus the crawler secret.
# SUPABASE_FUNCTION_JWT can be the anon key if the function keeps JWT verification enabled.
SUPABASE_FUNCTION_JWT=
SUPABASE_CRAWLER_SECRET=
